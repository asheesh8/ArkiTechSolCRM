generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  DEV
  MEMBER
}

enum LeadStatus {
  NEW
  SAVED
  CALLED
  MEETING_BOOKED
  NOT_INTERESTED
  FOLLOW_UP
  CLOSED
}

enum LeadPriority {
  STANDARD
  PRIORITY
  FAVORITE
}

enum CallOutcome {
  NO_ANSWER
  LEFT_VOICEMAIL
  CALLED
  NOT_INTERESTED
  FOLLOW_UP
  MEETING_BOOKED
  CLOSED
}

enum NoteType {
  GENERAL
  FOLLOW_UP
  MEETING
}

enum LeadExclusionReason {
  ARCHIVED
  DECLINED
}

model User {
  id                String                     @id @default(cuid())
  name              String
  email             String                     @unique
  passwordHash      String?
  role              Role                       @default(MEMBER)
  isActive          Boolean                    @default(true)
  leads             Lead[]                     @relation("AssignedLeads")
  callNotes         CallNote[]
  scrapeUsages      ScrapeUsage[]
  staffSessions     StaffSession[]
  ownerWorkLogs     OwnerWorkLog[]
  noteCabinets      NoteCabinet[]
  noteCabinetShares NoteCabinetShare[]
  notePages         NotePage[]
  notePresences     NotePresence[]
  devWorkRequests   WorkRequest[]              @relation("AssignedDevWorkRequests")
  coldCalls         ReceptionistConversation[]
  twilioAccount     TwilioAccount?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
}

/**
 * One teammate's own Twilio account, connected from the cold-call room.
 * Each rep brings their own number and their own bill, so a call is placed on
 * the credentials of whoever dialled it rather than a single company account.
 * When a user has no row here the dialer falls back to the TWILIO_* environment
 * variables, which is how a single shared company line still works.
 */
model TwilioAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  accountSid         String
  // The API key pair is provisioned for this app rather than pasted in, so it
  // can be revoked from the Twilio console without touching the auth token.
  apiKeySid          String
  // The TwiML app whose voice URL points back at /api/calls/voice. Created here
  // too — pointing it at the wrong URL is the step people get wrong by hand.
  twimlAppSid        String
  // E.164. Not a secret: it is what the prospect sees on caller ID.
  callerId           String
  friendlyName       String?
  // Encrypted with CREDENTIAL_ENCRYPTION_KEY. These place calls and spend money,
  // so they never sit in the database as plaintext and never leave the server.
  authTokenCipher    String   @db.Text
  apiKeySecretCipher String   @db.Text
  // An optional second account used only for texting.
  //
  // US carriers filter application-sent SMS from numbers whose A2P brand and
  // campaign aren't registered, and that registration takes days. Voice has no
  // such gate, so a rep whose own number can already call but not yet text can
  // point texting at a number that has cleared while their own is in review.
  // Null on both means texts go out on the same account as calls.
  smsAccountSid      String?
  smsAuthTokenCipher String?  @db.Text
  smsFrom            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Webhooks arrive knowing only the Twilio account, so that is the lookup path
  // for verifying a signature. Not unique: two teammates may share one account.
  @@index([accountSid])
}

model StaffSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OwnerWorkLog {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  workSummary String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startedAt])
  @@index([endedAt])
}

model Lead {
  id                        String                     @id @default(cuid())
  businessName              String
  category                  String?
  phone                     String?
  email                     String?
  website                   String?
  address                   String?
  city                      String?
  state                     String?
  googlePlaceId             String?                    @unique
  googleMapsUrl             String?
  googleRating              Float?
  googleReviewCount         Int?
  status                    LeadStatus                 @default(NEW)
  priority                  LeadPriority               @default(STANDARD)
  websiteScore              Int?
  pageSpeedPerformance      Int?
  pageSpeedAccessibility    Int?
  pageSpeedSEO              Int?
  pageSpeedBestPractices    Int?
  notes                     String?
  // Where the lead came from. Null for the scraped majority; "adcampaign" for
  // inbound from the paid landing page.
  source                    String?
  // Other numbers that reach this business — a switchboard, a gatekeeper's
  // desk, an owner's cell. Kept apart from `phone` so dialling a side door to
  // get through to someone never overwrites the number that was scraped.
  altPhones                 String[]                   @default([])
  assignedToId              String?
  assignedTo                User?                      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  callNotes                 CallNote[]
  audits                    Audit[]
  client                    Client?
  receptionistConversations ReceptionistConversation[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([status])
  @@index([priority])
  @@index([city, state])
  @@index([category])
  @@index([assignedToId])
  @@index([source, createdAt])
}

model CallNote {
  id              String      @id @default(cuid())
  leadId          String
  userId          String
  note            String
  noteType        NoteType    @default(GENERAL)
  callOutcome     CallOutcome
  followUpDate    DateTime?
  // Set when the note came from a call dialed inside the CRM rather than typed
  // up afterwards. The SID is what a recording and transcript will be joined on
  // once those exist; until then it is just provenance.
  durationSecs    Int?
  providerCallSid String?
  createdAt       DateTime    @default(now())
  lead            Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([noteType])
  @@index([followUpDate])
}

model Audit {
  id                     String   @id @default(cuid())
  leadId                 String?
  url                    String
  strategy               String   @default("mobile")
  performance            Int?
  accessibility          Int?
  seo                    Int?
  bestPractices          Int?
  firstContentfulPaint   String?
  largestContentfulPaint String?
  speedIndex             String?
  totalBlockingTime      String?
  cumulativeLayoutShift  String?
  opportunities          Json?
  createdAt              DateTime @default(now())
  lead                   Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([url])
}

model LeadExclusion {
  id            String              @id @default(cuid())
  googlePlaceId String              @unique
  businessName  String
  reason        LeadExclusionReason
  createdAt     DateTime            @default(now())

  @@index([reason])
}

model ScrapeUsage {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  monthKey  String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([monthKey])
  @@index([userId, monthKey])
}

// ─── Client Portal ───────────────────────────────────────────────────────────

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

model Client {
  id               String    @id @default(cuid())
  leadId           String?   @unique
  name             String
  email            String    @unique
  phone            String?
  businessName     String
  passwordHash     String?
  setupToken       String?   @unique
  setupExpiry      DateTime?
  sessionToken     String?   @unique
  sessionExpiry    DateTime?
  stripeCustomerId String?
  avatarUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contracts    Contract[]
  invoices     Invoice[]
  workRequests WorkRequest[]
  voiceAgents  VoiceAgent[]

  @@index([email])
}

model Contract {
  id                    String         @id @default(cuid())
  clientId              String
  planName              String
  lineItems             Json
  subtotal              Float
  tax                   Float          @default(0)
  total                 Float
  billingCycle          BillingCycle   @default(MONTHLY)
  status                ContractStatus @default(DRAFT)
  sentAt                DateTime?
  signedAt              DateTime?
  signatureData         String?
  signToken             String?        @unique
  notes                 String?
  documentKey           String?
  documentName          String?
  providerSignatureData String?
  providerSignedAt      DateTime?
  providerName          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id              String        @id @default(cuid())
  clientId        String
  contractId      String?
  stripeInvoiceId String?
  amount          Float
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime
  paidAt          DateTime?
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model WorkRequest {
  id                  String     @id @default(cuid())
  clientId            String?
  title               String
  description         String?
  status              WorkStatus @default(OPEN)
  requestType         String     @default("CLIENT_REQUEST")
  priority            String     @default("NORMAL")
  estimateHours       Float?
  actualHours         Float?
  repositoryUrl       String?
  dueDate             DateTime?
  assignedDeveloperId String?
  staffNote           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  client            Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedDeveloper User?      @relation("AssignedDevWorkRequests", fields: [assignedDeveloperId], references: [id], onDelete: SetNull)
  files             WorkFile[]

  @@index([clientId])
  @@index([status])
  @@index([assignedDeveloperId])
  @@index([dueDate])
}

model WorkFile {
  id            String   @id @default(cuid())
  workRequestId String
  name          String
  r2Key         String
  size          BigInt
  mimeType      String?
  createdAt     DateTime @default(now())

  workRequest WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)

  @@index([workRequestId])
}

// ─── AI Receptionist Archive ────────────────────────────────────────────────

model ReceptionistConversation {
  id                     String    @id @default(cuid())
  providerConversationId String    @unique
  // Null for calls a person placed from the cold-call room: there is no AI
  // agent behind those, only a teammate. `source` says which kind this is.
  agentId                String?
  agentName              String?
  status                 String
  callSuccessful         String?
  callSuccessScore       Float?
  title                  String?
  summary                String?   @db.Text
  searchText             String?   @db.Text
  callerPhone            String?
  agentPhone             String?
  direction              String?
  initiationSource       String?
  mainLanguage           String?
  terminationReason      String?
  durationSecs           Int       @default(0)
  messageCount           Int       @default(0)
  startedAt              DateTime
  endedAt                DateTime?
  hasAudio               Boolean   @default(false)
  costFiat               Float?
  rating                 Float?
  sentimentLabel         String?
  metadata               Json?
  analysis               Json?
  initiationData         Json?
  tagIds                 String[]  @default([])
  internalNote           String?   @db.Text
  leadId                 String?
  detailStatus           String?
  detailSyncedAt         DateTime?
  // Which pipeline produced this: "elevenlabs" for the AI receptionist,
  // "cold-call" for a call a teammate dialled from the CRM.
  source                 String?
  // The teammate who placed the call. Only ever set for "cold-call".
  userId                 String?
  // R2 object key for the recording, when one was kept.
  recordingKey           String?
  // Why a cold-call transcript is missing, so a gap is explained rather than
  // silently empty.
  processingError        String?   @db.Text
  syncedAt               DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  lead     Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ReceptionistMessage[]

  @@index([agentId, startedAt])
  @@index([startedAt])
  @@index([status])
  @@index([callSuccessful])
  @@index([callerPhone])
  @@index([leadId])
  @@index([source, startedAt])
  @@index([userId])
}

model ReceptionistMessage {
  id             String   @id @default(cuid())
  conversationId String
  sequence       Int
  role           String
  message        String?  @db.Text
  timeInCallSecs Float?
  interrupted    Boolean  @default(false)
  sourceMedium   String?
  rawData        Json?
  createdAt      DateTime @default(now())

  conversation ReceptionistConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId])
  @@index([role])
}

model ReceptionistSyncState {
  agentId             String    @id
  lastIncrementalAt   DateTime?
  lastFullReconcileAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  site      String
  path      String   @default("/")
  referrer  String?
  ipHash    String
  ua        String?
  createdAt DateTime @default(now())

  @@index([site])
  @@index([site, createdAt])
  @@index([createdAt])
}

// ─── Notes workspace ─────────────────────────────────────────────────────────
// A team-shared, AppFlowy-style docs area. Cabinets are the top-level "filing
// cabinets"; pages nest infinitely inside a cabinet via NotePage.parentId.

model NoteCabinet {
  id          String             @id @default(cuid())
  name        String             @default("New cabinet")
  icon        String             @default("📁")
  color       String             @default("blue")
  sortOrder   Int                @default(0)
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  pages       NotePage[]
  shares      NoteCabinetShare[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([sortOrder])
}

// Per-cabinet delegation. Owners (Role.OWNER) always see every cabinet; other
// roles see a cabinet only if they created it or a share row grants them access.
model NoteCabinetShare {
  id        String   @id @default(cuid())
  cabinetId String
  userId    String
  createdAt DateTime @default(now())

  cabinet NoteCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cabinetId, userId])
  @@index([userId])
}

model NotePage {
  id          String         @id @default(cuid())
  cabinetId   String
  cabinet     NoteCabinet    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      NotePage?      @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    NotePage[]     @relation("PageTree")
  title       String         @default("Untitled")
  icon        String         @default("📄")
  content     String         @default("")
  sortOrder   Int            @default(0)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  presences   NotePresence[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([cabinetId])
  @@index([parentId])
  @@index([cabinetId, parentId, sortOrder])
}

// Live "who's on this page" heartbeats for Google-Docs-style presence. Each
// client upserts its row on a short interval; stale rows (no recent heartbeat)
// are treated as gone and swept opportunistically.
model NotePresence {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  name      String
  updatedAt DateTime @updatedAt

  page NotePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([updatedAt])
}

// ─── Voice agents ────────────────────────────────────────────────────────────

// A voice agent that lives on ElevenLabs. The CRM catalogs the ones on the
// account rather than creating them, so agent config stays authored upstream
// and this table only owns the CRM-side facts: who the agent belongs to and
// whether it is exposed as a public demo.
model VoiceAgent {
  id              String    @id @default(cuid())
  // For ElevenLabs this mirrors the upstream agent id. For OpenAI there is no
  // remote agent to point at, so it holds a local "openai:<slug>" identifier
  // purely to keep the unique constraint meaningful.
  providerAgentId String    @unique
  // "elevenlabs" | "openai". Decides how a session is opened and, for the
  // roster sync, whether this row is even ElevenLabs' to archive.
  provider        String    @default("elevenlabs")
  // OpenAI has no dashboard to author a persona in — the prompt and voice are
  // sent from here on every session. Null for ElevenLabs-hosted agents.
  instructions    String?   @db.Text
  voice           String?
  name            String
  slug            String    @unique
  clientId        String?
  // Demo presentation — a prospect-facing pitch, not the agent's own prompt.
  demoEnabled     Boolean   @default(false)
  demoHeadline    String?
  demoSubheadline String?   @db.Text
  demoBusiness    String?
  isArchived      Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client       Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  demoSessions VoiceDemoSession[]

  @@index([clientId])
  @@index([demoEnabled])
}

// One prospect demo conversation. Rows are the rate-limit ledger for the public
// demo page and the record of which pitches actually got used.
model VoiceDemoSession {
  id        String   @id @default(cuid())
  agentId   String
  ipHash    String
  userAgent String?
  createdAt DateTime @default(now())

  agent VoiceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([ipHash, createdAt])
}

/// A row on the public pricing page, editable by owners in CRM settings so a
/// price change never needs a deploy. Money is stored in cents; the editor and
/// the page both format it.
model PricingPlan {
  id           String   @id @default(cuid())
  /// Stable key the marketing pages reference (e.g. "website-reviews").
  slug         String   @unique
  /// Which tab the plan sits under on /pricing.
  group        String
  name         String
  blurb        String
  /// Recurring price in cents. Null for one-off or "let's scope it" plans.
  monthlyCents Int?
  /// One-time price in cents. Null when the plan is purely recurring.
  onceCents    Int?
  /// Overrides the price line entirely — "From", "Scoped per project", etc.
  priceNote    String?
  features     String[]
  /// Marks the plan the page highlights.
  featured     Boolean  @default(false)
  /// Hide without deleting.
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([group, sortOrder])
}
