DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locallead_crm?schema=public"
GOOGLE_PLACES_API_KEY=""
GOOGLE_PAGESPEED_API_KEY=""
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google Calendar — server-side only. Use either one shared calendar ID or a comma-separated list.
GOOGLE_CALENDAR_ID="c8bbc50640d97a9a6b5e55a1765c42cd522a7ffec403397a5002be548c1d07ac@group.calendar.google.com"
GOOGLE_CALENDAR_IDS="" # e.g. "Ashish::ashish@example.com,Terri::terri@example.com"
GOOGLE_CALENDAR_EMBED_URL="https://calendar.google.com/calendar/embed?src=c8bbc50640d97a9a6b5e55a1765c42cd522a7ffec403397a5002be548c1d07ac%40group.calendar.google.com&ctz=America%2FNew_York"
GOOGLE_CALENDAR_API_KEY="" # optional, only works for public calendars
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY="" # paste with escaped \n newlines
GOOGLE_CALENDAR_SUBJECT="" # optional for Workspace domain-wide delegation

# Base44 FAQ/intake agent — server-side only; never prefix these with NEXT_PUBLIC_
BASE44_API_KEY=""
BASE44_AGENT_ID=""
BASE44_CONVERSATION_ID=""

# ElevenLabs receptionist archive — server-side only.
# ELEVENLABS_AGENT_ID is now only a fallback: agents synced into the Agents page
# are archived too. Leave it set so an existing deployment keeps working.
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""

# Salt for hashing demo-caller IPs in the rate-limit ledger. Optional — falls
# back to ELEVENLABS_WEBHOOK_SECRET. Set a distinct value in production.
DEMO_IP_SALT=""

# OpenAI Realtime — server-side only, used by voice agents whose provider is
# "openai". Unlike ElevenLabs there is no hosted agent: the prompt and voice
# live in VoiceAgent.instructions / VoiceAgent.voice and are sent per session.
# Set OPENAI_REALTIME_MODEL to gpt-realtime-2.1-mini to cut audio cost ~3x.
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"

# Public URL (used in email links and Stripe redirect URLs)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ─── Browser dialling for the cold-call room ─────────────────────────────────
# All server-side. The browser only ever receives a short-lived access token.
# These are the *shared company line*: the fallback used by any teammate who
# hasn't connected their own Twilio account from the cold-call room. Leave them
# blank and each rep simply connects their own; leave them set and everyone
# dials on this one until they don't.
#
# Connecting an account in the UI needs only an Account SID and Auth Token —
# the API key and TwiML app below are created automatically from those. Filling
# this section in by hand is the manual equivalent:
#   1. Buy a number, or verify the number you already own so it can be used as
#      outbound caller ID without porting it.
#   2. Create an API key (Account > API keys) for the SID/secret pair below.
#   3. Create a TwiML App whose Voice Request URL is
#      https://yourdomain.com/api/calls/voice  (method POST), and put its SID in
#      TWILIO_TWIML_APP_SID.
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# The account auth token — used only to verify that TwiML requests really came
# from Twilio. Without it the dialling endpoint would be an open relay.
TWILIO_AUTH_TOKEN=""
TWILIO_TWIML_APP_SID=""
# What the prospect sees. E.164, and must be a number you own or have verified.
TWILIO_CALLER_ID="+18023103749"
# Only needed when the public URL Twilio calls differs from NEXT_PUBLIC_APP_URL
# (a preview deployment, or a tunnel while developing). Signature validation
# hashes this URL, so it has to match exactly what Twilio requested.
TWILIO_VOICE_WEBHOOK_URL=""

# Encrypts the Twilio credentials teammates connect from the cold-call room.
# Without it the connect form refuses to store anything, because the only
# alternative is keeping an auth token in the database as plaintext.
#
#   openssl rand -hex 32
#
# Rotating this doesn't corrupt anything — connected accounts simply read as
# "needs reconnecting" until each rep connects again.
CREDENTIAL_ENCRYPTION_KEY=""

# ─── Blooio: iMessage and RCS, with SMS underneath ───────────────────────────
# Blooio picks the best channel the recipient's handset supports, so an iPhone
# gets a blue-bubble thread rather than a grey one. Set this and it becomes the
# sender for cold texts; leave it blank and everything goes out over Twilio.
#
# Twilio stays wired either way. A send that fails at Blooio is retried on
# Twilio rather than reported as a failure, so one vendor being down doesn't
# stop the day.
BLOOIO_API_KEY=""
# Only needed on a Blooio account holding more than one number — otherwise the
# sender is chosen at the account level.
BLOOIO_FROM_NUMBER=""
# Override the API host. The default is https://api.blooio.com/v2/api.
BLOOIO_API_BASE=""

# ─── Call recording, transcripts and automatic write-ups ─────────────────────
# OFF by default, and it should stay off until you've read this.
#
# Vermont is a one-party consent state, but cold calls cross state lines, and
# California, Pennsylvania, Florida, Washington, Massachusetts and Illinois all
# require EVERY party to consent. In Massachusetts recording without notice is a
# criminal matter, not a civil one.
#
# Setting this to true turns on dual-channel recording AND plays the notice
# below to whoever answers, before the call is bridged — the two are wired
# together on purpose so recording can't be switched on silently. The notice is
# captured on the recording itself, which is the proof worth having.
TWILIO_RECORD_CALLS="false"
# Override the wording if your lawyer prefers different phrasing.
TWILIO_CONSENT_ANNOUNCEMENT=""

# Transcription and the write-up both run on the OpenAI key above. whisper-1 is
# the model that returns segment timestamps, which is what lets the two recorded
# channels be merged back into one ordered transcript — a model without them
# would lose the speaker labels that dual-channel recording exists to provide.
# This is the swap point for a self-hosted faster-whisper server later.
OPENAI_TRANSCRIBE_MODEL="whisper-1"
OPENAI_SUMMARY_MODEL="gpt-4o-mini"

# ─── /cleaningbook landing page ──────────────────────────────────────────────
# Meta Pixel id for the Facebook ad campaign. Public by design — it ships in the
# page source. Override this if the campaign moves to a different pixel.
# It still only fires after the visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID="2090867258498539"

# Optional Cal.com / Calendly / Google appointment link. When set, a "pick a
# time" button appears above the callback form on /cleaningbook.
NEXT_PUBLIC_BOOKING_URL=""

# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Cloudflare R2 — get from Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET="arkitech-portal"
R2_PUBLIC_URL="https://your-bucket.r2.dev"  # optional public URL for files
